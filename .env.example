# 大模型配置（填你自己的 DeepSeek / 通义 / 智谱 key）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Redis（本地服务已注册开机自启；密码见 D:\Redis\redis.windows.conf 的 requirepass）
REDIS_URL=redis://:你的密码@127.0.0.1:6379/0

# DuckDB 数据库文件（D 盘）
DUCKDB_PATH=D:/crawl_analyst/data/crawl_data.duckdb

# 原始网页 markdown 落盘目录
RAW_MD_DIR=D:/crawl_analyst/data/raw_md

# Parquet 归档目录
PARQUET_DIR=D:/crawl_analyst/data/parquet

# ---------------- 安全与限流 ----------------
# URL 准入策略：open=任意公网 http/https（推荐）| demo=仅示例站点 | allowlist=仅 PAGE_URL_ALLOWLIST
PAGE_URL_POLICY=open
PAGE_URL_ALLOWLIST=
PAGE_URL_DEMO_HOSTS=books.toscrape.com,sspai.com,arxiv.org,quotes.toscrape.com
PAGE_ALLOWED_PORTS_EXTRA=

# 限流：单 IP / 单域名 / 每日总预算
RL_IP_PER_MIN=3
RL_HOST_PER_MIN=5
RL_DAILY_TASKS=200

# 单次分析最多出几张图（每个分析目标一张）
PAGE_MAX_CHARTS=3

# ---------------- 公网部署 ----------------
# Docker compose 里 redis 服务的密码（务必改掉 changeme）
REDIS_PASSWORD=changeme
# 对外暴露时打开基础鉴权：PUBLIC_AUTH=1 + 用户名 + 密码
# 本地开发保持 0，免登录
PUBLIC_AUTH=0
PUBLIC_USER=demo
PUBLIC_PASS=
# 对外服务端口（默认 8000；用反代时不对公网开放）
APP_PORT=8000
